<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="360.0" prefWidth="480.0" spacing="10"
      style="-fx-background-color:#f3eaf8; -fx-padding:20;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.chocolateria.controller.popupBuscarSuplidorController">

    <Label style="-fx-text-fill:#3B1A5C; -fx-font-size:14px; -fx-font-weight:bold;" text="Buscar Suplidor" />
    <Separator />

    <TextField fx:id="txtBuscar" prefHeight="30" promptText="Buscar por RNC o nombre…"
               style="-fx-background-color:white; -fx-border-color:#9b59b6; -fx-border-radius:6; -fx-background-radius:6;" />

    <TableView fx:id="tablaSuplidores" VBox.vgrow="ALWAYS"
               style="-fx-background-radius:10; -fx-border-radius:10; -fx-border-color:#C5A8E8;">
        <columns>
            <TableColumn fx:id="colRnc" prefWidth="150"
                         style="-fx-background-color:#48295a; -fx-text-fill:white; -fx-font-weight:bold;" text="RNC" />
            <TableColumn fx:id="colNombre" prefWidth="280"
                         style="-fx-background-color:#48295a; -fx-text-fill:white; -fx-font-weight:bold;" text="Nombre" />
        </columns>
        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER" spacing="14">
        <Button onAction="#seleccionar" prefHeight="30" prefWidth="130"
                style="-fx-background-color:#6d3c87; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:10; -fx-cursor:hand;"
                text="Seleccionar" />
        <Button onAction="#cerrar" prefHeight="30" prefWidth="100"
                style="-fx-background-color:#c9a8e8; -fx-text-fill:#3B1A5C; -fx-font-weight:bold; -fx-background-radius:10; -fx-cursor:hand;"
                text="Cerrar" />
    </HBox>
</VBox>
