<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1020.0" style="-fx-background-color: #f3eaf8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chocolateria.controller.ventaController">

    <left>
        <VBox alignment="TOP_CENTER" prefHeight="720.0" prefWidth="190.0" spacing="6" style="-fx-background-color:#48295a;">
            <padding>
                <Insets bottom="20" left="10" right="10" top="24" />
            </padding>

            <StackPane maxHeight="80" maxWidth="80" minHeight="80" minWidth="80">
                <ImageView fx:id="imgFotoPerfil" fitHeight="100.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../com/example/chocolateria/perfilr.png" />
                    </image>
                </ImageView>
            </StackPane>

            <Label fx:id="lblUsuario" alignment="CENTER" prefHeight="20.0" prefWidth="91.0" style="-fx-text-fill:#eadcf2; -fx-font-weight:bold;" text="" wrapText="true">
                <font><Font name="Courier New" size="10" /></font>
            </Label>

            <Separator opacity="0.2" prefWidth="155.0" />

            <Button maxWidth="Infinity" onAction="#irAInicio" prefHeight="33.0" style="-fx-background-color:#8b5aa6; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:14;" text="🏠  Inicio">
                <font><Font size="12" /></font>
            </Button>

            <Separator opacity="0.1" prefWidth="155.0" />

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="530.0" style="-fx-background-color:transparent; -fx-background:transparent; -fx-border-color:transparent;" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                <VBox spacing="4" style="-fx-background-color:transparent; -fx-padding: 0 0 4 0;">

                    <TitledPane animated="true" expanded="true" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="Ventas">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irAOrdenCliente" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Orden de cliente" />
                            <Button maxWidth="Infinity" onAction="#irAPagoVenta" style="-fx-background-color:#5a2d82; -fx-text-fill:#ffd6ff; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent; -fx-font-weight:bold;" text="• Registro de pagos de ventas" wrapText="true" />
                            <Button maxWidth="Infinity" onAction="#irAGestionEnvios" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Gestión de envíos" />
                            <Button maxWidth="Infinity" onAction="#irAGestionReclamos" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Gestión de reclamos" />
                        </VBox>
                    </TitledPane>

                    <TitledPane animated="true" expanded="false" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="Producción">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irASolicitudProduccion" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Solicitud de producción" wrapText="true" />
                            <Button maxWidth="Infinity" onAction="#irAOrdenProduccion" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Orden de producción" />
                        </VBox>
                    </TitledPane>

                    <TitledPane animated="true" expanded="false" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="Compras">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irAOrdenProveedor" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Orden a proveedor" />
                            <Button maxWidth="Infinity" onAction="#irASalidaMateriales" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Recepción de productos" wrapText="true" />
                            <Button maxWidth="Infinity" onAction="#irAPagoCompra" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Registro de pagos por compras" wrapText="true" />
                        </VBox>
                    </TitledPane>

                    <TitledPane animated="true" expanded="false" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="Inventario">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irASalidaMateriales" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Salida de materiales para producción" wrapText="true" />
                            <Button maxWidth="Infinity" onAction="#irASalidaProductos" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Salida de productos por ventas" wrapText="true" />
                        </VBox>
                    </TitledPane>

                    <TitledPane animated="true" expanded="false" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="Registros">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irARegistroProducto" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Registro de productos" />
                            <Button maxWidth="Infinity" onAction="#irARegistroEmpleado" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Registro de empleado" />
                            <Button maxWidth="Infinity" onAction="#irARegistroCliente" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Registro de cliente" />
                            <Button maxWidth="Infinity" onAction="#irARegistroSuplidor" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Registro de suplidor" />
                            <Button maxWidth="Infinity" onAction="#irARegistroMaquinaria" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Registro de máquinas" />
                        </VBox>
                    </TitledPane>

                    <TitledPane animated="true" expanded="false" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="Mantenimiento">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irAMantenimientoMaquinaria" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Mantenimiento de maquinarias" wrapText="true" />
                        </VBox>
                    </TitledPane>

                    <TitledPane animated="true" expanded="false" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="🔎  Consultas">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irAConsultas" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Consultas generales" />
                        </VBox>
                    </TitledPane>

                </VBox>
            </ScrollPane>

            <Separator opacity="0.1" />

            <Button maxWidth="Infinity" onAction="#salir" prefHeight="38" style="-fx-background-color:#a83c5b; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:14;" text="🚪  Salir">
                <font><Font size="13" /></font>
            </Button>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED">
            <VBox spacing="10" style="-fx-padding: 0 0 16 0; -fx-background-color: #f3eaf8;">

                <StackPane maxWidth="Infinity" style="-fx-border-color:#9b59b6; -fx-border-width:0 0 2 0;">
                    <ImageView fx:id="imgBanner" fitHeight="114.0" fitWidth="830.0" pickOnBounds="true" preserveRatio="false" smooth="true">
                        <image>
                            <Image url="@../com/example/chocolateria/banner.png" />
                        </image>
                    </ImageView>
                </StackPane>

                <VBox spacing="10" style="-fx-padding: 4 20 0 20;">

                    <!-- formulario venta -->
                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12;                                  -fx-border-color: #C5A8E8; -fx-border-radius: 12;                                  -fx-padding: 14 18 14 18;                                  -fx-effect: dropshadow(gaussian,rgba(75,41,90,0.10),8,0,0,2);">

                        <Label style="-fx-text-fill:#3B1A5C; -fx-font-size:14px; -fx-font-weight:bold;" text="REGISTRO DE PAGO DE VENTA">
                            <font><Font name="Arial" size="12.0" /></font>
                        </Label>
                        <Separator />

                        <!-- fila 1: id venta, id orden, cliente, fecha -->
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox minHeight="52" prefWidth="110" spacing="3">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="ID Venta" />
                                <TextField fx:id="txtIdVenta" editable="true" prefHeight="28" promptText="Buscar…" style="-fx-background-color:#f0eaf8; -fx-text-fill:#555;                                                   -fx-border-color:purple; -fx-border-radius:6;                                                   -fx-background-radius:6;" />
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="ID Orden cliente" />
                                <HBox spacing="6">
                                    <TextField fx:id="txtIdOrden" prefHeight="28" prefWidth="80" promptText="ID…" style="-fx-background-color:white; -fx-text-fill:black;                                                       -fx-border-color:purple; -fx-border-radius:6;                                                       -fx-background-radius:6;" />
                                    <Button text="🔍" onAction="#abrirBuscadorOrden" prefHeight="28" prefWidth="32" style="-fx-background-color:#6d3c87; -fx-text-fill:white; -fx-background-radius:6; -fx-cursor:hand; -fx-font-size:13;" />
                                    <Button onAction="#cargarDesdeOrden" prefHeight="28" prefWidth="130" style="-fx-background-color:#48295a; -fx-text-fill:white;                                                    -fx-font-weight:bold; -fx-background-radius:8;" text="📋  Cargar orden" />
                                    <Label fx:id="lblInfoOrden" style="-fx-text-fill:#3B1A5C; -fx-font-size:11px; -fx-font-weight:bold;" text="" />
                                </HBox>
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Fecha de venta" />
                                <DatePicker fx:id="dpFechaVenta" maxWidth="Infinity" prefHeight="28" style="-fx-background-color:white; -fx-border-color:purple;                                                    -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                        </HBox>

                        <!-- fila 2: empleado, tipo pago, metodo pago, ncf -->
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="ID Empleado" />
                                <HBox spacing="6">
                                    <TextField fx:id="txtIdEmpleado" prefHeight="28" prefWidth="60" promptText="ID…" style="-fx-background-color:white; -fx-text-fill:black;                                                       -fx-border-color:purple; -fx-border-radius:6;                                                       -fx-background-radius:6;" />
                                    <Button onAction="#buscarEmpleado" prefHeight="28" prefWidth="70" style="-fx-background-color:#6d3c87; -fx-text-fill:white;                                                    -fx-font-weight:bold; -fx-background-radius:8;" text="Buscar" />
                                    <Label fx:id="lblNombreEmpleado" style="-fx-text-fill:#3B1A5C; -fx-font-size:11px; -fx-font-weight:bold;" text="" />
                                </HBox>
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Tipo de pago" />
                                <ComboBox fx:id="cbTipoPago" maxWidth="Infinity" prefHeight="28" style="-fx-background-color:white; -fx-border-color:purple;                                                  -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Método de pago" />
                                <ComboBox fx:id="cbMetodoPago" maxWidth="Infinity" prefHeight="28" style="-fx-background-color:white; -fx-border-color:purple;                                                  -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Tipo NCF" />
                                <ComboBox fx:id="cbTipoNcf" maxWidth="Infinity" prefHeight="28" style="-fx-background-color:white; -fx-border-color:purple;                                                  -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                        </HBox>

                        <!-- fila 3: resumen financiero -->
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Subtotal (RD$)" />
                                <TextField fx:id="txtSubtotal" editable="false" prefHeight="28" style="-fx-background-color:#f0eaf8; -fx-text-fill:#3B1A5C;                                                   -fx-font-weight:bold; -fx-border-color:purple;                                                   -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Descuento (RD$)" />
                                <TextField fx:id="txtDescuento" prefHeight="28" promptText="0.00" style="-fx-background-color:white; -fx-text-fill:black;                                                   -fx-border-color:purple; -fx-border-radius:6;                                                   -fx-background-radius:6;" />
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="ITBIS 18% (RD$)" />
                                <TextField fx:id="txtItbis" editable="false" prefHeight="28" style="-fx-background-color:#f0eaf8; -fx-text-fill:#3B1A5C;                                                   -fx-font-weight:bold; -fx-border-color:purple;                                                   -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Total a pagar (RD$)" />
                                <TextField fx:id="txtTotal" editable="false" prefHeight="28" style="-fx-background-color:#f0eaf8; -fx-text-fill:#3B1A5C;                                                   -fx-font-weight:bold; -fx-border-color:purple;                                                   -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                        </HBox>

                        <!-- fila 4: monto pagado, balance, estado, ncf generado -->
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Monto pagado (RD$)" />
                                <TextField fx:id="txtMontoPagado" editable="false" prefHeight="28" style="-fx-background-color:#f0eaf8; -fx-text-fill:#2e7d32;                                                   -fx-font-weight:bold; -fx-border-color:purple;                                                   -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Balance pendiente (RD$)" />
                                <TextField fx:id="txtBalancePendiente" editable="false" prefHeight="28" style="-fx-background-color:#f0eaf8; -fx-text-fill:#c0392b;                                                   -fx-font-weight:bold; -fx-border-color:purple;                                                   -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Estado del pago" />
                                <TextField fx:id="txtEstadoPago" editable="false" prefHeight="28" style="-fx-background-color:#f0eaf8; -fx-font-weight:bold;                                                   -fx-border-color:purple; -fx-border-radius:6;                                                   -fx-background-radius:6;" />
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="NCF generado" />
                                <TextField fx:id="txtNcf" editable="false" prefHeight="28" style="-fx-background-color:#f0eaf8; -fx-text-fill:#3B1A5C;                                                   -fx-font-weight:bold; -fx-border-color:purple;                                                   -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                        </HBox>

                        <Separator />

                        <HBox alignment="CENTER" spacing="10">
                            <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#registrarVenta" prefHeight="30" prefWidth="130" text="Registrar Venta"><font><Font size="11.0" /></font></Button>
                            <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#fnBuscar" prefHeight="30" prefWidth="100" style="-fx-background-color:#6d3c87; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:12;" text="Buscar"><font><Font size="11.0" /></font></Button>
                            <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#fnEditar" prefHeight="30" prefWidth="100" style="-fx-background-color:#5a2d82; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:12;" text="Editar"><font><Font size="11.0" /></font></Button>
                            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#fnEliminar" prefHeight="30" prefWidth="100" text="Eliminar"><font><Font size="11.0" /></font></Button>
                            <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiar" prefHeight="30" prefWidth="100" style="-fx-background-color:#6d3c87; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:12;" text="Limpiar"><font><Font size="11.0" /></font></Button>
                            <Button mnemonicParsing="false" onAction="#irAConsultaPagosVenta" prefHeight="30" prefWidth="130" style="-fx-background-color:#2e7d32; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:12;" text="Ver Consulta"><font><Font size="11.0" /></font></Button>
                        </HBox>
                    </VBox>

                    <!-- abono pago -->
                    <VBox spacing="7" style="-fx-background-color:white; -fx-background-radius:12;                                  -fx-border-color:#C5A8E8; -fx-border-radius:12;                                  -fx-padding:12 16 12 16;                                  -fx-effect: dropshadow(gaussian,rgba(75,41,90,0.10),8,0,0,2);">

                        <Label style="-fx-text-fill:#3B1A5C; -fx-font-size:12px; -fx-font-weight:bold;" text="Registrar Abono / Pago" />

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <DatePicker fx:id="dpFechaPago" prefHeight="28" prefWidth="155" style="-fx-background-color:white; -fx-border-color:#C5A8E8;                                                -fx-border-radius:6; -fx-background-radius:6;" />
                            <TextField fx:id="txtMontoAbono" prefHeight="28" prefWidth="130" promptText="Monto (RD$)" style="-fx-background-color:white; -fx-text-fill:black;                                               -fx-border-color:#C5A8E8; -fx-border-radius:6;                                               -fx-background-radius:6;" />
                            <ComboBox fx:id="cbMetodoPagoAbono" prefHeight="28" prefWidth="150" style="-fx-background-color:white; -fx-border-color:#C5A8E8;                                              -fx-border-radius:6; -fx-background-radius:6;" />
                            <TextField fx:id="txtReferencia" prefHeight="28" prefWidth="140" promptText="N° referencia" style="-fx-background-color:white; -fx-text-fill:black;                                               -fx-border-color:#C5A8E8; -fx-border-radius:6;                                               -fx-background-radius:6;" />
                            <Button fx:id="btnAbono" onAction="#registrarAbono" prefHeight="28" prefWidth="120" text="✔  Registrar" />
                        </HBox>

                        <TableView fx:id="tablaPagos" prefHeight="130" style="-fx-background-radius:10; -fx-border-radius:10;                                           -fx-border-color:#C5A8E8; -fx-background-color:#f3eaf8;" VBox.vgrow="NEVER">
                            <columns>
                                <TableColumn fx:id="colPagoId" style="-fx-background-color:#48295a; -fx-text-fill:white; -fx-font-weight:bold; -fx-alignment:CENTER;" text="ID" />
                                <TableColumn fx:id="colPagoFecha" style="-fx-background-color:#48295a; -fx-text-fill:white; -fx-font-weight:bold; -fx-alignment:CENTER;" text="Fecha" />
                                <TableColumn fx:id="colPagoMonto" style="-fx-background-color:#48295a; -fx-text-fill:white; -fx-font-weight:bold; -fx-alignment:CENTER;" text="Monto (RD$)" />
                                <TableColumn fx:id="colPagoMetodo" style="-fx-background-color:#48295a; -fx-text-fill:white; -fx-font-weight:bold; -fx-alignment:CENTER;" text="Método" />
                                <TableColumn fx:id="colPagoRef" style="-fx-background-color:#48295a; -fx-text-fill:white; -fx-font-weight:bold; -fx-alignment:CENTER;" text="Referencia" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </VBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
