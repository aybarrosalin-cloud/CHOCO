<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1020.0" style="-fx-background-color: #f3eaf8;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.chocolateria.controller.ordenClienteController">

    <left>
        <VBox alignment="TOP_CENTER" prefHeight="720.0" prefWidth="190.0" spacing="6" style="-fx-background-color:#48295a;">
            <padding>
                <Insets bottom="20" left="10" right="10" top="24" />
            </padding>

            <StackPane maxHeight="80" maxWidth="80" minHeight="80" minWidth="80">
                <ImageView fx:id="imgFotoPerfil" fitHeight="100.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../com/example/chocolateria/perfilr.png" />
                    </image>
                </ImageView>
            </StackPane>

            <Label fx:id="lblUsuario" alignment="CENTER" prefHeight="20.0" prefWidth="91.0" style="-fx-text-fill:#eadcf2; -fx-font-weight:bold;" text="" wrapText="true">
                <font><Font name="Courier New" size="10" /></font>
            </Label>

            <Separator opacity="0.2" prefWidth="155.0" />

            <Button maxWidth="Infinity" onAction="#irAInicio" prefHeight="33.0" style="-fx-background-color:#8b5aa6; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:14;" text="🏠  Inicio">
                <font><Font size="12" /></font>
            </Button>

            <Separator opacity="0.1" prefWidth="155.0" />

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="530.0" style="-fx-background-color:transparent; -fx-background:transparent; -fx-border-color:transparent;" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                <VBox spacing="4" style="-fx-background-color:transparent; -fx-padding: 0 0 4 0;">

                    <TitledPane animated="true" expanded="true" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="Ventas">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irAOrdenCliente" style="-fx-background-color:#5a2d82; -fx-text-fill:#ffd6ff; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent; -fx-font-weight:bold;" text="• Orden de cliente" />
                            <Button maxWidth="Infinity" onAction="#irAPagoVenta" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Registro de pagos de ventas" wrapText="true" />
                            <Button maxWidth="Infinity" onAction="#irAGestionEnvios" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Gestión de envíos" />
                            <Button maxWidth="Infinity" onAction="#irAGestionReclamos" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Gestión de reclamos" />
                        </VBox>
                    </TitledPane>

                    <TitledPane animated="true" expanded="false" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="Producción">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irASolicitudProduccion" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Solicitud de producción" wrapText="true" />
                            <Button maxWidth="Infinity" onAction="#irAOrdenProduccion" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Orden de producción" />
                        </VBox>
                    </TitledPane>

                    <TitledPane animated="true" expanded="false" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="Inventario">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irASalidaMateriales" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Salida de materiales para producción" wrapText="true" />
                            <Button maxWidth="Infinity" onAction="#irASalidaProductos" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Salida de productos por ventas" wrapText="true" />
                        </VBox>
                    </TitledPane>

                    <TitledPane animated="true" expanded="false" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="Compras">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irAOrdenProveedor" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Orden a proveedor" />
                            <Button maxWidth="Infinity" onAction="#irAPagoCompra" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Registro de pagos por compras" wrapText="true" />
                        </VBox>
                    </TitledPane>

                    <TitledPane animated="true" expanded="false" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="Registros">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irARegistroProducto" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Registro de productos" />
                            <Button maxWidth="Infinity" onAction="#irARegistroEmpleado" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Registro de empleado" />
                            <Button maxWidth="Infinity" onAction="#irARegistroCliente" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Registro de cliente" />
                            <Button maxWidth="Infinity" onAction="#irARegistroSuplidor" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Registro de suplidor" />
                            <Button maxWidth="Infinity" onAction="#irARegistroMaquinaria" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Registro de máquinas" />
                        </VBox>
                    </TitledPane>


                    <TitledPane animated="true" expanded="false" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="Mantenimiento">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irAMantenimientoMaquinaria" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Mantenimiento de maquinarias" wrapText="true" />
                        </VBox>
                    </TitledPane>

                    <TitledPane animated="true" expanded="false" style="-fx-base:#3d1055; -fx-background-color:#3d1055; -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:11px;" text="🔎  Consultas">
                        <VBox spacing="1" style="-fx-background-color:#2a0a3a; -fx-padding:4 0 4 0;">
                            <Button maxWidth="Infinity" onAction="#irAConsultas" style="-fx-background-color:transparent; -fx-text-fill:#e8d5f5; -fx-font-size:10px; -fx-alignment:CENTER_LEFT; -fx-padding:4 8 4 16; -fx-border-color:transparent;" text="• Consultas generales" />
                        </VBox>
                    </TitledPane>

                </VBox>
            </ScrollPane>

            <Separator opacity="0.1" />

            <Button maxWidth="Infinity" onAction="#salir" prefHeight="38" style="-fx-background-color:#a83c5b; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:14;" text="🚪  Salir">
                <font><Font size="13" /></font>
            </Button>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED">
            <VBox spacing="10" style="-fx-padding: 0 0 16 0; -fx-background-color: #f3eaf8;">

                <StackPane maxWidth="Infinity" style="-fx-border-color:#9b59b6; -fx-border-width:0 0 2 0;">
                    <ImageView fx:id="imgBanner" fitHeight="114.0" fitWidth="830.0" pickOnBounds="true" preserveRatio="false" smooth="true">
                        <image>
                            <Image url="@../com/example/chocolateria/banner.png" />
                        </image>
                    </ImageView>
                </StackPane>

                <VBox spacing="10" style="-fx-padding: 4 20 0 20;">

                    <!-- datos generales -->
                    <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 12;                                              -fx-border-color: #C5A8E8; -fx-border-radius: 12;                                              -fx-padding: 14 18 14 18;                                              -fx-effect: dropshadow(gaussian,rgba(75,41,90,0.10),8,0,0,2);">

                        <Label style="-fx-text-fill:#3B1A5C; -fx-font-size:14px; -fx-font-weight:bold;" text="NUEVA ORDEN DE CLIENTE">
                            <font><Font name="Arial" size="12.0" /></font>
                        </Label>
                        <Separator />

                        <!-- fila 1: id, cliente, fecha registro -->
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox minHeight="52" prefWidth="110" spacing="3">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="ID Orden" />
                                <TextField fx:id="txtCodigo" editable="true" prefHeight="28" promptText="Buscar…" style="-fx-background-color:#f0eaf8; -fx-text-fill:#555;                                                   -fx-border-color:purple; -fx-border-radius:6;                                                   -fx-background-radius:6;" />
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Cliente (ID)" />
                                <HBox spacing="4" alignment="CENTER_LEFT">
                                    <TextField fx:id="txtIdCliente" prefHeight="28" prefWidth="55" promptText="ID" style="-fx-background-color:white; -fx-border-color:purple; -fx-border-radius:6; -fx-background-radius:6;" />
                                    <Button text="🔍" onAction="#abrirBuscadorCliente" prefHeight="28" prefWidth="32"
                                            style="-fx-background-color:#6d3c87; -fx-text-fill:white; -fx-background-radius:6; -fx-cursor:hand; -fx-font-size:13;" />
                                    <TextField fx:id="txtNombreCliente" editable="false" prefHeight="28" promptText="Nombre cliente" style="-fx-background-color:#f0eaf8; -fx-border-color:purple; -fx-border-radius:6; -fx-background-radius:6;" HBox.hgrow="ALWAYS" />
                                </HBox>
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Fecha de registro" />
                                <DatePicker fx:id="dpFecha" maxWidth="Infinity" prefHeight="28" style="-fx-background-color:white; -fx-border-color:purple;                                                    -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                        </HBox>

                        <!-- fila 2: fecha entrega, metodo pago, estado, cajero -->
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Fecha de entrega" />
                                <DatePicker fx:id="dpFecha1" maxWidth="Infinity" prefHeight="28" style="-fx-background-color:white; -fx-border-color:purple;                                                    -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Método de pago" />
                                <ChoiceBox fx:id="cbMetodoPago" maxWidth="Infinity" prefHeight="28" style="-fx-background-color:white; -fx-border-color:purple;                                                   -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Estado" />
                                <ChoiceBox fx:id="cbEstado" maxWidth="Infinity" prefHeight="28" style="-fx-background-color:white; -fx-border-color:purple;                                                   -fx-border-radius:6; -fx-background-radius:6;" />
                            </VBox>
                            <VBox minHeight="52" spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Atendido por (ID)" />
                                <HBox spacing="4" alignment="CENTER_LEFT">
                                    <TextField fx:id="txtIdCajero" prefHeight="28" prefWidth="55" promptText="ID" style="-fx-background-color:white; -fx-border-color:purple; -fx-border-radius:6; -fx-background-radius:6;" />
                                    <TextField fx:id="txtCajero" editable="false" prefHeight="28" promptText="Nombre empleado" style="-fx-background-color:#f0eaf8; -fx-border-color:purple; -fx-border-radius:6; -fx-background-radius:6;" HBox.hgrow="ALWAYS" />
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- fila 3: observaciones -->
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox spacing="3" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-weight:bold; -fx-font-size:11px; -fx-text-fill:#3B1A5C;" text="Observaciones" />
                                <TextArea fx:id="txtObservaciones" prefHeight="55" style="-fx-background-color:white; -fx-text-fill:black;                                                  -fx-border-color:purple; -fx-border-radius:6;                                                  -fx-background-radius:6;" />
                            </VBox>
                        </HBox>

                        <Separator />

                        <!-- botones -->
                        <HBox alignment="CENTER" spacing="10">
                            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardar" prefHeight="30" prefWidth="100" text="Guardar">
                                <font><Font size="11.0" /></font>
                            </Button>
                            <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#fnEditar" prefHeight="30" prefWidth="100" text="Editar">
                                <font><Font size="11.0" /></font>
                            </Button>
                            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#fnEliminar" prefHeight="30" prefWidth="100" text="Eliminar">
                                <font><Font size="11.0" /></font>
                            </Button>
                            <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#fnBuscar" prefHeight="30" prefWidth="100" style="-fx-background-color:#6d3c87; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:12;" text="Buscar">
                                <font><Font size="11.0" /></font>
                            </Button>
                            <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarCampos" prefHeight="30" prefWidth="100" style="-fx-background-color:#6d3c87; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:12;" text="Limpiar">
                                <font><Font size="11.0" /></font>
                            </Button>
                            <Button onAction="#irAConsultaOrdenCliente" prefHeight="30" prefWidth="140" style="-fx-background-color:#2e7d32; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:10; -fx-cursor:hand; -fx-font-size:11px;" text="Ver Consulta" />
                            <Button onAction="#generarReporte" prefHeight="30" prefWidth="140" style="-fx-background-color:#3d1055; -fx-text-fill:#ffd6ff; -fx-font-weight:bold; -fx-background-radius:12; -fx-font-size:11px;" text="Generar Reporte"><font><Font size="11.0" /></font></Button>
                            <Button onAction="#exportarPDF" prefHeight="30" prefWidth="130" style="-fx-background-color:#8B0000; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:12; -fx-font-size:11px;" text="Exportar PDF"><font><Font size="11.0" /></font></Button>
                        </HBox>
                    </VBox>

                    <!-- detalle productos -->
                    <VBox spacing="7" style="-fx-background-color:white; -fx-background-radius:12;                                              -fx-border-color:#C5A8E8; -fx-border-radius:12;                                              -fx-padding:12 16 12 16;                                              -fx-effect: dropshadow(gaussian,rgba(75,41,90,0.10),8,0,0,2);">

                        <Label style="-fx-text-fill:#3B1A5C; -fx-font-size:12px; -fx-font-weight:bold;" text="Productos de la Orden" />

                        <!-- agregar producto -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <TextField fx:id="txtIdProducto" prefHeight="28" prefWidth="110" promptText="Código producto" style="-fx-background-color:white; -fx-text-fill:black;                                               -fx-border-color:#C5A8E8; -fx-border-radius:6;                                               -fx-background-radius:6;" />
                            <Button onAction="#buscarProducto" prefHeight="28" prefWidth="70" style="-fx-background-color:#6d3c87; -fx-text-fill:white;                                            -fx-font-weight:bold; -fx-background-radius:8;" text="Buscar" />
                            <TextField fx:id="txtNombreProducto" editable="false" prefHeight="28" prefWidth="140" promptText="Nombre producto" style="-fx-background-color:#f0eaf8; -fx-text-fill:#3B1A5C; -fx-font-weight:bold; -fx-border-color:#C5A8E8; -fx-border-radius:6; -fx-background-radius:6;" />
                            <TextField fx:id="txtCantidad" prefHeight="28" prefWidth="80" promptText="Cantidad" style="-fx-background-color:white; -fx-text-fill:black;                                               -fx-border-color:#C5A8E8; -fx-border-radius:6;                                               -fx-background-radius:6;" />
                            <TextField fx:id="txtPrecio" editable="false" prefHeight="28" prefWidth="80" promptText="Precio" style="-fx-background-color:#f0eaf8; -fx-text-fill:black;                                               -fx-border-color:#C5A8E8; -fx-border-radius:6;                                               -fx-background-radius:6;" />
                            <Button onAction="#agregarProducto" prefHeight="28" prefWidth="100" style="-fx-background-color:#48295a; -fx-text-fill:white;                                            -fx-font-weight:bold; -fx-background-radius:8;" text="➕  Agregar" />
                            <Button onAction="#quitarProducto" prefHeight="28" prefWidth="93.0" style="-fx-background-color:#a83c5b; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:8;" text="✖  Quitar" />
                        </HBox>

                        <TableView fx:id="tablaDetalle" prefHeight="220" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colDetCodigo" prefWidth="100" style="-fx-background-color:#48295a; -fx-text-fill:white; -fx-font-weight:bold; -fx-alignment:CENTER;" text="Código" />
                                <TableColumn fx:id="colDetProducto" prefWidth="210" style="-fx-background-color:#48295a; -fx-text-fill:white; -fx-font-weight:bold; -fx-alignment:CENTER;" text="Producto" />
                                <TableColumn fx:id="colDetCantidad" prefWidth="80" style="-fx-background-color:#48295a; -fx-text-fill:white; -fx-font-weight:bold; -fx-alignment:CENTER;" text="Cantidad" />
                                <TableColumn fx:id="colDetPrecio" prefWidth="163.99996948242188" style="-fx-background-color:#48295a; -fx-text-fill:white; -fx-font-weight:bold; -fx-alignment:CENTER;" text="Precio unit. (RD$)" />
                                <TableColumn fx:id="colDetTotal" prefWidth="202.39996337890625" style="-fx-background-color:#48295a; -fx-text-fill:white; -fx-font-weight:bold; -fx-alignment:CENTER;" text="Subtotal (RD$)" />
                            </columns>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="16" style="-fx-padding:6 4 2 4;">
                            <Label style="-fx-text-fill:#3B1A5C; -fx-font-size:13px; -fx-font-weight:bold;" text="Total de la orden:" />
                            <Label fx:id="lblTotal" style="-fx-text-fill:#48295a; -fx-font-size:15px; -fx-font-weight:bold; -fx-background-color:#f0eaf8; -fx-background-radius:8; -fx-padding:4 14 4 14; -fx-border-color:#C5A8E8; -fx-border-radius:8;" text="RD$ 0.00" />
                            <Button onAction="#generarCotizacion" prefHeight="32" prefWidth="175" style="-fx-background-color:#48295a; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:10; -fx-font-size:12px;" text="📄  Generar Cotización" />
                        </HBox>

                    </VBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
